{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake_Build_Project",
            "type": "shell",
            
            "command": "cmake -E make_directory build && cmake -B build -S . && cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
